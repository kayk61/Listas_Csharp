using System;
using System.Collections.Generic;

namespace lista_5
{
    class Program
    {
        static void Main(string[] args)
        {
            // mude o numero da opçao para testar as demais consultas
            int opcao = 1;

            switch (opcao)
            {
                case 1: exercicio01(); break; 
                case 2: exercicio02(); break; 
                case 3: exercicio03(); break; 
                case 4: exercicio04(); break; 
                case 5: exercicio05(); break; 
                case 6: exercicio06(); break; 
                case 7: exercicio07(); break; 
                case 8: exercicio08(); break; 
                case 9: exercicio09(); break; 
                case 10: exercicio10(); break; 

                default: Console.WriteLine("opcao invalida"); break;
            }

            Console.WriteLine("\nPressione qualquer tecla para sair...");
            Console.ReadKey();
        }

    
        static void exercicio01()
        {
            Console.WriteLine("Digite um numero inteiro:");
            int numero = int.Parse(Console.ReadLine());

            string resultado = (numero % 2 == 0) ? "Par" : "Ímpar";
            Console.WriteLine("O número é: " + resultado);
        }

     
        static void exercicio02()
        {
            Console.WriteLine("Digite o primeiro numero:");
            int num1 = int.Parse(Console.ReadLine());
            Console.WriteLine("Digite o segundo numero:");
            int num2 = int.Parse(Console.ReadLine());

            int maior = (num1 > num2) ? num1 : num2;
            Console.WriteLine("O maior número é: " + maior);
        }

       
        static void exercicio03()
        {
            List<string> lista = new List<string>();

            string status = (lista.Count == 0) ? "A lista está vazia" : "A lista possui elementos";
            Console.WriteLine(status);
        }

        
        static void exercicio04()
        {
            Console.WriteLine("Digite um texto ou pressione ENTER para deixar vazio:");
            string texto = Console.ReadLine();

            string resultado = string.IsNullOrEmpty(texto) ? "A string está vazia" : "A string contém texto";
            Console.WriteLine(resultado);
        }

        static void exercicio05()
        {
            Console.WriteLine("Digite a sua idade:");
            int idade = int.Parse(Console.ReadLine());

            bool ehMaiorDeIdade = idade >= 18;
            string mensagem = ehMaiorDeIdade ? "Condição verdadeira (Maior de idade)" : "Condição falsa (Menor de idade)";

            Console.WriteLine(mensagem);
        }

        static void exercicio06()
        {
            Console.WriteLine("Digite um numero (positivo ou negativo):");
            int numero = int.Parse(Console.ReadLine());

            int absoluto = (numero < 0) ? -numero : numero;
            Console.WriteLine("O valor absoluto é: " + absoluto);
        }

        static void exercicio07()
        {
            Console.WriteLine("Digite um numero:");
            int numero = int.Parse(Console.ReadLine());

            string resultado = (numero > 0) ? "Positivo" : (numero < 0) ? "Negativo" : "Zero";
            Console.WriteLine("O número é: " + resultado);
        }

        static void exercicio08()
        {
            Console.WriteLine("Digite um numero em formato de texto:");
            string entrada = Console.ReadLine();

            int numeroConvertido;
            bool sucesso = int.TryParse(entrada, out numeroConvertido);

            string mensagem = sucesso ? "Número convertido com sucesso: " + numeroConvertido : "Falha ao converter a string em número.";
            Console.WriteLine(mensagem);
        }

        static void exercicio09()
        {
            Console.WriteLine("Digite o numero dividendo:");
            int num1 = int.Parse(Console.ReadLine());
            Console.WriteLine("Digite o numero divisor:");
            int num2 = int.Parse(Console.ReadLine());

            string resultado = (num2 != 0 && num1 % num2 == 0) ? num1 + " é divisível por " + num2 : num1 + " NÃO é divisível por " + num2;
            Console.WriteLine(resultado);
        }

        static void exercicio10()
        {
            string nome = null;

            string resultado = (nome == null) ? "A variável é nula" : "A variável NÃO é nula";
            Console.WriteLine(resultado);
        }
    }
}
