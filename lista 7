        static void exercicio01()
        {
            Console.WriteLine("Digite um numero inteiro positivo:");
            int limite = int.Parse(Console.ReadLine());

            int i = 0;
            while (i <= limite)
            {
                if (i % 2 == 0)
                {
                    Console.WriteLine(i);
                }
                i++;
            }
        }

        static void exercicio02()
        {
            Console.WriteLine("Digite um numero inteiro para ver sua tabuada:");
            int numero = int.Parse(Console.ReadLine());

            int contador = 1;
            while (contador <= 10)
            {
                Console.WriteLine(numero + " x " + contador + " = " + (numero * contador));
                contador++;
            }
        }

        static void exercicio03()
        {
            Console.WriteLine("Quantos numeros deseja somar?");
            int quantidade = int.Parse(Console.ReadLine());

            int soma = 0;
            int contador = 1;

            while (contador <= quantidade)
            {
                Console.WriteLine("Digite o " + contador + "º numero:");
                soma += int.Parse(Console.ReadLine());
                contador++;
            }

            Console.WriteLine("A soma de todos os numeros é: " + soma);
        }

        static void exercicio04()
        {
            string senhaCorreta = "1234";
            int tentativas = 0;
            bool acertou = false;

            while (tentativas < 3 && !acertou)
            {
                Console.WriteLine("Digite a senha:");
                string senhaDigitada = Console.ReadLine();
                tentativas++;

                if (senhaDigitada == senhaCorreta)
                {
                    acertou = true;
                    Console.WriteLine("Sucesso! Senha correta.");
                }
                else
                {
                    Console.WriteLine("Senha incorreta!");
                }
            }

            if (!acertou)
            {
                Console.WriteLine("Acesso bloqueado! Numero maximo de tentativas excedido.");
            }
        }

