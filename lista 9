        static void exercicio01()
        {
            int[] numeros = { 10, 20, 30, 40, 50 };

            for (int i = 0; i < numeros.Length; i++)
            {
                Console.WriteLine("Elemento na posicao " + i + ": " + numeros[i]);
            }
        }

        static void exercicio02()
        {
            string[] nomes = new string[5];
            double[] nota1 = new double[5];
            double[] nota2 = new double[5];

            for (int i = 0; i < 5; i++)
            {
                Console.WriteLine("Digite o nome do " + (i + 1) + "º aluno:");
                nomes[i] = Console.ReadLine();

                Console.WriteLine("Digite a primeira nota de " + nomes[i] + ":");
                nota1[i] = double.Parse(Console.ReadLine());

                Console.WriteLine("Digite a segunda nota de " + nomes[i] + ":");
                nota2[i] = double.Parse(Console.ReadLine());
            }

            Console.WriteLine("\n--- LISTAGEM DOS ALUNOS ---");
            for (int i = 0; i < 5; i++)
            {
                double media = (nota1[i] + nota2[i]) / 2;
                Console.WriteLine("Nome: " + nomes[i] + " | Nota 1: " + nota1[i] + " | Nota 2: " + nota2[i] + " | Média: " + media.ToString("F2"));
            }
        }

        static void exercicio03()
        {
            double[] valores = { 5.5, 7.2, 9.0, 4.8, 6.5 };
            double soma = 0;

            for (int i = 0; i < valores.Length; i++)
            {
                soma += valores[i];
            }

            double media = soma / valores.Length;
            Console.WriteLine("A média dos valores do vetor é: " + media.ToString("F2"));
        }

