        static void exercicio10()
        {
            string[] nomes = new string[40];
            int[] quantidades = new int[40];
            double[] precios = new double[40];
            int totalCadastrados = 0;
            int opcaoMenu = 0;

            while (opcaoMenu != 3)
            {
                Console.WriteLine("\nMENU");
                Console.WriteLine("1. Cadastra mercadorias");
                Console.WriteLine("2. Exibe valor total em mercadorias da empresa");
                Console.WriteLine("3. Sair");
                Console.Write("OPÇÃO: ");
                opcaoMenu = int.Parse(Console.ReadLine());

                if (opcaoMenu == 1)
                {
                    if (totalCadastrados < 40)
                    {
                        Console.WriteLine("\nCadastrando mercadoria " + (totalCadastrados + 1) + " de 40:");
                        Console.Write("Nome: ");
                        nomes[totalCadastrados] = Console.ReadLine();

                        Console.Write("Quantidade em estoque: ");
                        quantidades[totalCadastrados] = int.Parse(Console.ReadLine());

                        Console.Write("Preço unitário: ");
                        precios[totalCadastrados] = double.Parse(Console.ReadLine());

                        totalCadastrados++;
                        Console.WriteLine("Mercadoria cadastrada com sucesso!");
                    }
                    else
                    {
                        Console.WriteLine("Limite máximo de 40 mercadorias atingido!");
                    }
                }
                else if (opcaoMenu == 2)
                {
                    double valorTotalEmpresa = 0;

                    for (int i = 0; i < totalCadastrados; i++)
                    {
                        valorTotalEmpresa += quantidades[i] * precios[i];
                    }

                    Console.WriteLine("\nValor total em mercadorias da empresa: R$ " + valorTotalEmpresa.ToString("F2"));
                }
                else if (opcaoMenu != 3)
                {
                    Console.WriteLine("Opção inválida!");
                }
            }
        }
